# ==============================================================================
# Cindercrest 2.0 Environment Configuration Template
# DO NOT put real keys, secrets, or passwords in this file.
# Copy this file to .env for local development: cp .env.example .env
# ==============================================================================

# Server configuration (localhost binding only)
CINDERCREST_HOST=127.0.0.1
CINDERCREST_PORT=8000
CINDERCREST_DEBUG=false

# Ephemeral Session Token (Leave blank to generate a random 32-byte hex token on startup)
CINDERCREST_SESSION_TOKEN=

# Database configuration
CINDERCREST_DATABASE_URL=sqlite:///./data/cindercrest.db

# Model Providers
# Local Ollama service (default)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# Optional Hosted Groq LLM for ultra-fast cloud inference
# Cindercrest uses local Ollama or Groq when configured.
CINDERCREST_GROQ_API_KEY=
CINDERCREST_GROQ_MODEL=qwen/qwen3.8-27b

# Audio & Voice Settings
VOICE_SAMPLE_RATE=16000
VOICE_VAD_THRESHOLD=0.5
VOICE_DEFAULT_SYNTHESIZER=onecore
